APP_ROLE=all
APP_PORT=8080
APP_ADMIN_TOKEN=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_LOGIN_ENABLED=false
LOG_LEVEL=info

DATABASE_URL=postgres://bridge:bridge@postgres:5432/x_waha_bridge
REDIS_URL=redis://redis:6379

X_PROVIDER=auto
X_API_BASE_URL=https://api.x.com/2
X_BEARER_TOKEN=
X_NITTER_BASE_URL=https://nitter.net
X_SOURCE_USERNAMES=xdevelopers,vercel,github
X_FETCH_INTERVAL_MS=90000
X_FETCH_BATCH_SIZE=10
X_BOOTSTRAP_MODE=latest
X_SCHEDULER_LOCK_MS=180000

WAHA_BASE_URL=https://your-waha-host.example.com
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WAHA_SESSION_NAME=default
WAHA_TARGETS=
WAHA_FORWARD_TARGETS=
WAHA_CHANNEL_ID=123456789@newsletter

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_SEND_MEDIA=true

MESSAGE_HEADER=[X Mirror]
MESSAGE_FOOTER=
SEND_MEDIA=true
PUBLISH_CONCURRENCY=1
PUBLISH_ATTEMPTS=3
PUBLISH_BACKOFF_MS=5000
PUBLISH_INLINE=false

# Required when using /cron/sync (external scheduler, e.g. Railway Cron or any cron job)
CRON_SECRET=
